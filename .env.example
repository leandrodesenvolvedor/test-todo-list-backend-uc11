# Configuração da Todo List API
#
# Copie este arquivo para `.env` — ele já vem pronto para rodar:
#
#     cp .env.example .env                  # Linux / macOS
#     Copy-Item .env.example .env           # Windows (PowerShell)
#
# A DATABASE_URL abaixo está ATIVA de propósito. Ela é obrigatória: sem ela a
# aplicação não sobe, e a mensagem de erro diz onde o .env é procurado. Não há
# banco padrão silencioso — a escolha é sempre explícita.


# ----------------------------------------------------------------------------
# BANCO DE DADOS  (obrigatório)
# ----------------------------------------------------------------------------

# --- Desenvolvimento local: SQLite em arquivo -------------------------------
# Não exige instalar nada: o SQLite vem na biblioteca padrão do Python, e o
# arquivo é criado na primeira execução.
DATABASE_URL=sqlite:///./todo_list.db

# --- PostgreSQL local, para testar o banco de produção na sua máquina -------
# DATABASE_URL=postgresql+psycopg://postgres:senha@localhost:5432/todo_list_db

# --- PostgreSQL gerenciado (produção) ---------------------------------------
# A maioria das plataformas de hospedagem entrega esta URL pronta. Pode colar
# como vem: se ela começar com `postgres://`, a aplicação corrige o esquema e o
# driver automaticamente.
# Bancos gerenciados normalmente exigem SSL — daí o `?sslmode=require`.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/banco?sslmode=require


# ----------------------------------------------------------------------------
# AUTENTICAÇÃO  (obrigatório)
# ----------------------------------------------------------------------------

# Chave que assina os tokens de acesso (JWT). Quem a conhece consegue emitir um
# token válido para qualquer usuário — portanto ela é tão sensível quanto a
# senha do banco.
#
# O valor abaixo está ATIVO para que o projeto rode ao ser clonado, e por isso
# mesmo está publicado no repositório: NÃO é segredo. A aplicação RECUSA subir
# com ele quando o banco configurado é um banco de servidor (a marca de
# produção neste projeto).
#
# Precisa ter ao menos 32 bytes (RFC 7518, seção 3.2) — a aplicação recusa
# subir com um segredo mais curto. Gere o seu com:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-gerado

# Validade do token, em horas. Sem declarar, vale 168 (7 dias).
#
# Um valor curto (0.5 = 30 minutos) é mais seguro, porque um token vazado
# expira logo; mas obriga a entrar de novo várias vezes ao dia, já que não há
# refresh token. 7 dias é o acordo adotado aqui, compatível com um front-end
# que mantém a sessão entre fechamentos do navegador.
# JWT_EXPIRACAO_HORAS=168


# ----------------------------------------------------------------------------
# CORS — quem pode chamar a API pelo navegador  (opcional)
# ----------------------------------------------------------------------------
# Separe múltiplas origens por vírgula. Sem declarar, vale o front-end local
# (http://localhost:5173 e http://127.0.0.1:5173).
# ORIGENS_PERMITIDAS=https://meuapp.com.br,https://www.meuapp.com.br


# ----------------------------------------------------------------------------
# DEPURAÇÃO  (opcional)
# ----------------------------------------------------------------------------
# Com ECHO_SQL ligado, todo SQL gerado pelo SQLAlchemy aparece no terminal.
# Útil para entender o que o ORM está fazendo; ruidoso demais para deixar ligado.
# ECHO_SQL=true


# ----------------------------------------------------------------------------
# NOTA SOBRE A VERSÃO ANTERIOR
# ----------------------------------------------------------------------------
# As variáveis DB_HOST, DB_PORT, DB_USER, DB_PASSWORD e DB_NAME, usadas quando o
# projeto rodava em MySQL, não são mais lidas. O equivalente em URL é:
#
#   DATABASE_URL=mysql+mysqlconnector://usuario:senha@localhost:3306/todo_list_db
#
# (nesse caso, instale também o driver: pip install mysql-connector-python)
